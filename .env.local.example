# Copy this file to .env.local and fill in your values

# ── Deployment region/whitelabel profile ────────────────────────────────
# Selects branding, enabled tender sources, company verification, currency,
# default locale, theme, and AI/geocoding defaults. One of: uk | cn | th.
# Defaults to "uk". See lib/deployment/ and docs/deployment-profiles.md.
DEPLOYMENT_PROFILE=uk

OPENAI_API_KEY=your-openai-key
DEEPSEEK_API_KEY=your-deepseek-key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key

# ── Embeddings (Basic Match) ─────────────────────────────────────────────
# Default (no EMBED_PROVIDER): OpenAI text-embedding-3-small @ 1536 when
# OPENAI_API_KEY is set. Schema stores vector(1536) — migration 0008.
#
# Force local Ollama embeddings (1024-dim native, zero-padded to 1536 in DB):
# EMBED_PROVIDER=ollama
# EMBED_MODEL=qwen3-embedding:0.6b
# EMBED_DIM=1024
#
# ── Inference plane (hosted service — see infra/inference/) ───────────────
# Team + Vercel: deploy Ollama once (Oracle Free / Hetzner / Fly), then point here.
# Solo offline dev: use http://127.0.0.1:11434 instead.
#
# EMBED_PROVIDER=ollama
# EMBED_MODEL=qwen3-embedding:0.6b
# EMBED_DIM=1024
# Shared inference service (all devs + Vercel previews):
# EMBED_BASE_URL=https://inference.yourdomain.com
# INFERENCE_BASE_URL=https://inference.yourdomain.com/v1
# INFERENCE_API_KEY=shared-secret-from-infra/inference/.env
# EMBED_API_KEY=shared-secret-from-infra/inference/.env
#
# Local-only fallback:
EMBED_BASE_URL=http://127.0.0.1:11434
INFERENCE_BASE_URL=http://127.0.0.1:11434/v1
MATCHING_MODEL=ollama/qwen2.5:7b
#
# Docs: infra/inference/README.md  +  docs/deployment-profiles.md
# EMBED_INSTRUCTIONS=0
# BASIC_MATCH_STRUCTURAL=0
# BASIC_MATCH_REQUIRE_TAXONOMY=0
# BASIC_MATCH_EMBED_RERANK=1
# Email Configuration (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=your-resend-key
PLATFORM_EMAIL_FROM=noreply@yourdomain.com
PLATFORM_NAME=TNDRX Platform
PLATFORM_URL=http://localhost:3000

# TED (EU) tenders - optional for Search API; get key from https://docs.ted.europa.eu/api/latest/
TED_API_KEY=

# Tender sync (cron / admin trigger) - can use same value as CRON_SECRET
TENDER_SYNC_SECRET=

# Google Maps Geocoding - enables location-based company filtering
# Get a key from https://console.cloud.google.com (enable Geocoding API)
GOOGLE_MAPS_API_KEY=

# Better Auth + PostgreSQL (Drizzle ORM)
# Local: Docker Postgres via `npm run docker:up`
# Production: may use a Supabase-hosted Postgres connection string (DATABASE_URL only; no Supabase SDK)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/tndrx
BETTER_AUTH_SECRET=your-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

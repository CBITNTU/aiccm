# Supabase Configuration
# Copy this file to .env.local and fill in your values

# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

OPENAI_API_KEY=your-openai-key
DEEPSEEK_API_KEY=your-deepseek-key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key

# Local LLM (Ollama) — for tender matching experiments on dev machine
# Install: brew install ollama && ollama serve
#   ollama pull qwen2.5:7b              # deep LLM scoring (benchmarks)
#   ollama pull qwen3-embedding:0.6b    # Basic Match vectors (pgvector)
# Test: npm run test:ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
MATCHING_MODEL=ollama/qwen2.5:7b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# Optional: qwen3-embedding:4b for higher retrieval quality (same OLLAMA_EMBED_DIM=768 via MRL)
OLLAMA_EMBED_DIM=768
# Set to 0 to disable Qwen instruction prefixes on embed text
# OLLAMA_EMBED_INSTRUCTIONS=0
# Basic Match accuracy toggles (all on by default)
# BASIC_MATCH_STRUCTURAL=0
# BASIC_MATCH_REQUIRE_TAXONOMY=0
# Optional second pass: query↔tender embed similarity (same OLLAMA_EMBED_MODEL)
# BASIC_MATCH_EMBED_RERANK=1
# Email Configuration (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=your-resend-key
PLATFORM_EMAIL_FROM=noreply@yourdomain.com
PLATFORM_NAME=TNDRX Platform
PLATFORM_URL=http://localhost:3000

# TED (EU) tenders - optional for Search API; get key from https://docs.ted.europa.eu/api/latest/
TED_API_KEY=

# Tender sync (cron / admin trigger) - can use same value as CRON_SECRET
TENDER_SYNC_SECRET=

# Google Maps Geocoding - enables location-based company filtering
# Get a key from https://console.cloud.google.com (enable Geocoding API)
GOOGLE_MAPS_API_KEY=

# Better Auth (new auth system)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/tndrx
BETTER_AUTH_SECRET=your-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

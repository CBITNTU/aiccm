{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint:strict && npm run typecheck",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod",
    "uk:deploy": "node scripts/deploy.mjs uk",
    "uk:deploy:prod": "node scripts/deploy.mjs uk --prod",
    "cn:deploy": "node scripts/deploy.mjs cn",
    "cn:deploy:prod": "node scripts/deploy.mjs cn --prod",
    "uk:migrate:prod": "node scripts/migrate.mjs uk --prod",
    "cn:migrate:prod": "node scripts/migrate.mjs cn --prod",
    "gen:secrets": "node scripts/gen-secrets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset-local:drizzle": "node scripts/reset-local-db-for-drizzle.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed-local-db.mjs",
    "db:seed-ref": "node scripts/seed-reference-data.mjs",
    "db:seed-demo:cn": "node scripts/seed-demo-companies-cn.mjs",
    "db:fresh": "node scripts/reset-and-seed.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test:ollama": "node scripts/test-ollama-matching.mjs",
    "test:ollama:zod": "tsx scripts/test-ollama-zod.ts",
    "test:tenders": "tsx scripts/test-tender-fetch.ts",
    "bench:matching": "tsx benchmarks/matching/run.ts",
    "bench:matching:bundled": "tsx benchmarks/matching/bundled.ts",
    "bench:matching:compare": "tsx benchmarks/matching/compare.ts",
    "bench:matching:summary": "tsx benchmarks/matching/summary.ts",
    "bench:matching:retrieval": "tsx benchmarks/matching/retrieval/run.ts",
    "embed:backfill": "tsx scripts/backfill-embeddings.ts",
    "validate:locales": "tsx scripts/validate-locale.ts th",
    "inference:up": "docker compose -f infra/inference/docker-compose.yml up -d",
    "inference:down": "docker compose -f infra/inference/docker-compose.yml down",
    "inference:bootstrap": "docker compose -f infra/inference/docker-compose.yml --profile bootstrap run --rm bootstrap",
    "inference:logs": "docker compose -f infra/inference/docker-compose.yml logs -f ollama",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.20",

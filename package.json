    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.29.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.561.0",
    "next": "16.2.6",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "p-limit": "^7.2.0",
    "pg": "^8.20.0",
    "react": "19.2.6",
    "react-day-picker": "^9.12.0",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.68.0",
    "react-resizable-panels": "^4.0.3",
    "recharts": "^3.6.0",
    "resend": "^6.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}

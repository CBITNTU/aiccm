    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.12",
    "ai": "^6.0.57",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-state-city": "^3.2.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
